# ==============================================================================
# DRIVAIR BACKEND ENVIRONMENT VARIABLES (SERVER)
# Copy this file to .env and provide appropriate credentials.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=5000

# Client Application URL (For CORS & Socket.IO Origin Whitelisting)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas Replica Set or Local URI)
# In production, use a replica-set cluster URI for multi-document transaction support.
MONGODB_URI=mongodb://127.0.0.1:27017/drivair

# Google Firebase Admin Credentials (Server-side token verification)
# Obtain these from your Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: In .env files, private keys containing newlines can be formatted with literal \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloudinary Storage Credentials (KYC and Vehicle Document uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional: Rate Limiting & Scaling Configuration
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
